# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put real values here.

# ─── Database (Neon Postgres) ────────────────────────────────────────────
# Pooled endpoint — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Same database, direct (non-pooled) endpoint — drop "-pooler" from the host.
# Prisma runs migrations over this: PgBouncer in transaction mode cannot
# execute DDL or hold the advisory locks migrations need.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Better Auth ─────────────────────────────────────────────────────────
# Signs session tokens. Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=""
# The site's own origin. Requests from any other origin are rejected, so this
# must match the deployed URL exactly in production.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Admin account ───────────────────────────────────────────────────────
# Consumed only by `npm run seed:admin`, which creates or resets the account.
# Public sign-up is disabled, so this script is the only way in.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
